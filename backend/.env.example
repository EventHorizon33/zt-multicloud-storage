# Zero-Trust Multi-Cloud Chunked Storage — backend configuration.
# Copy to backend/.env (read from the backend/ working directory) or export the
# variables. Every variable has the ZT_ prefix (app/config.py: Settings).
# NO REAL SECRETS BELONG IN THIS FILE OR IN VERSION CONTROL.
# Values shown are the defaults unless marked "example".

# ---------------------------------------------------------------- general
# ZT_ENV defaults to production when unset (review M4): no auto-generated KMS root
# key, no /docs or /openapi.json, HSTS on, fault injection and insecure cookies
# refused. Local work needs ZT_ENV=development explicitly (scripts/run-dev.sh sets it).
ZT_ENV=development                 # example for local work; development | test | production
ZT_DATA_DIR=./data                # SQLite DBs, KMS keystore, download spool
# ZT_DATABASE_URL=                # default sqlite:///<data_dir>/metadata.db ; Postgres: postgresql+psycopg2://...
# ZT_AUDIT_DATABASE_URL=          # default sqlite:///<data_dir>/audit.db (separate store, ADR-0006)
ZT_CORS_ORIGINS=["http://localhost:5173"]   # JSON list of allowed browser origins
# Client IP behind proxies (ADR-0011, review H2). With trust on, ALL X-Forwarded-For
# header lines are joined and the entry ZT_TRUSTED_PROXY_HOPS positions from the right
# is the client; malformed or too-short chains are refused with 400 bad-forwarded-for.
ZT_TRUST_FORWARDED_FOR=false      # true ONLY behind trusted reverse proxies that append to X-Forwarded-For
ZT_TRUSTED_PROXY_HOPS=1           # number of appending proxies in front of the backend (1..16)
# ZT_TRUSTED_PROXY_CIDRS=["10.0.0.0/8"]   # example: honour the header only from these peers (default: any peer)
# /metrics (review L5): no peer address is trusted. Scrapers send
# "Authorization: Bearer <token>"; without a token only an admin access token works.
# ZT_METRICS_TOKEN=<at-least-32-random-characters>
ZT_LOG_LEVEL=INFO

# ------------------------------------------- bootstrap admin (optional)
# Created at startup if both are set and the username does not exist yet.
# The password must satisfy the password policy (>= 12 chars, not common).
# ZT_BOOTSTRAP_ADMIN_USERNAME=admin               # example
# ZT_BOOTSTRAP_ADMIN_PASSWORD=<set-me-out-of-band>

# ---------------------------------------------------------------- auth
ZT_ACCESS_TOKEN_TTL_SECONDS=300
ZT_REFRESH_TOKEN_TTL_SECONDS=28800
ZT_SESSION_ABSOLUTE_TTL_SECONDS=43200
ZT_SESSION_IDLE_TTL_SECONDS=1800
ZT_TOKEN_ISSUER=zt-multicloud-storage
ZT_TOKEN_AUDIENCE=zt-api
ZT_PASSWORD_MIN_LENGTH=12
ZT_MAX_FAILED_LOGINS=5
ZT_LOCKOUT_SECONDS=900
ZT_MFA_STEP_UP_MAX_AGE_SECONDS=600
ZT_BIND_SESSION_TO_IP=false
ZT_COOKIE_SECURE=true             # false only for plain-http local development (scripts/run-dev.sh sets it)
# MFA at sign-in and enrolment gating (ADR-0010)
ZT_REQUIRE_MFA_FOR_LOGIN=true                 # password-only sessions are restricted to MFA enrolment
ZT_MFA_SELF_ENROLL_WINDOW_SECONDS=86400       # new accounts may enrol their first factor alone within this
ZT_MFA_ENROLLMENT_CODE_TTL_SECONDS=86400      # admin-issued, single-use enrolment codes
ZT_MFA_PENDING_ENROLLMENT_TTL_SECONDS=900     # enrol -> activate must happen within this
ZT_ALLOW_SELF_REGISTRATION=true               # false: POST /api/auth/register -> 403 registration-disabled

# ------------------------------------------------------- rate limiting
ZT_RATE_LIMIT_LOGIN_PER_MINUTE=10
ZT_RATE_LIMIT_REGISTER_PER_MINUTE=5
ZT_RATE_LIMIT_UPLOAD_PER_MINUTE=30
ZT_RATE_LIMIT_DOWNLOAD_PER_MINUTE=60
ZT_RATE_LIMIT_VERIFY_PER_MINUTE=6             # file verify + repair, per user (review L6)
ZT_RATE_LIMIT_AUDIT_EXPORT_PER_MINUTE=6       # NDJSON audit export, per user (review L7)
ZT_RATE_LIMIT_INVALID_TOKEN_PER_MINUTE=20     # failed bearer tokens per client network (IPv4 /32, IPv6 /64; review M2)

# ---------------------------------------------------------------- KMS
ZT_KMS_BACKEND=local              # local | aws
# ZT_KMS_KEYSTORE_PATH=           # default <data_dir>/kms/keystore.json
# Root key (base64 of 32 random bytes), REQUIRED in production. Use ONE of:
# ZT_KMS_ROOT_KEY=<base64>                 # e.g. from a secret manager
# ZT_KMS_ROOT_KEY_FILE=/run/secrets/zt_root_key   # file containing the base64 key
# Only with ZT_ENV=development or test is a key generated into <data_dir>/kms/ if neither is set;
# in production (the default) startup fails without one.
# ZT_AWS_KMS_KEY_ID=              # kms_backend=aws: symmetric CMK id/ARN
# ZT_AWS_KMS_ENDPOINT_URL=        # optional (e.g. a local KMS emulator)

# ------------------------------------------------------ chunking / crypto
ZT_CHUNK_SIZE_BYTES=1048576
ZT_MAX_UPLOAD_BYTES=268435456

# ------------------------------------------------------------- storage
ZT_STORAGE_PROVIDERS=aws-s3,azure-blob,gcs
ZT_REPLICATION_FACTOR=2
ZT_MIN_WRITE_REPLICAS=2
ZT_PLACEMENT_STRATEGY=rotating    # rotating | hash
ZT_STORAGE_TIMEOUT_SECONDS=10.0
ZT_RETRY_MAX_ATTEMPTS=4
ZT_RETRY_BASE_DELAY_SECONDS=0.2
ZT_RETRY_MAX_DELAY_SECONDS=3.0
ZT_HEALTH_CHECK_INTERVAL_SECONDS=15.0
ZT_ENABLE_FAULT_INJECTION=false   # demo/testing only; refused in production

# AWS S3 (real AWS: leave the endpoint unset and prefer the default credential chain)
ZT_S3_BUCKET=zt-chunks
ZT_S3_REGION=us-east-1
# ZT_S3_ENDPOINT_URL=http://127.0.0.1:5001     # moto emulator (scripts/emulators.sh)
# ZT_S3_ACCESS_KEY_ID=test                      # moto accepts dummy credentials
# ZT_S3_SECRET_ACCESS_KEY=test

# Azure Blob (real Azure: a container-scoped SAS connection string from a secret store)
ZT_AZURE_CONTAINER=zt-chunks
# Azurite emulator: Microsoft's PUBLIC, documented development account (not a secret):
# ZT_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Google Cloud Storage (real GCS: Application Default Credentials, endpoint unset)
ZT_GCS_BUCKET=zt-chunks
# ZT_GCS_PROJECT=zt-local
# ZT_GCS_ENDPOINT_URL=http://127.0.0.1:9023    # gcp-storage-emulator

# --------------------------------------------------------------- audit
ZT_AUDIT_CHECKPOINT_EVERY=100
ZT_AUDIT_RETENTION_DAYS=365
ZT_AUDIT_ANCHOR_CHECKPOINTS=true
ZT_AUDIT_IP_PREFIX_V4=24
ZT_AUDIT_IP_PREFIX_V6=48

# ----------------------------------------------------------- detection
ZT_DETECT_WINDOW_SECONDS=300
ZT_DETECT_MAX_DOWNLOADS_IN_WINDOW=20
ZT_DETECT_MAX_DOWNLOAD_BYTES_IN_WINDOW=536870912
ZT_DETECT_BLOCK_SECONDS=600
