# Copy to deploy/.env (git-ignored) and fill in. NO REAL SECRETS IN THIS FILE.
# Bootstrap admin, created at first start if absent. The password must satisfy the
# password policy (>= 12 characters, not a common password). After the first sign-in
# the admin must enrol TOTP (Account screen) and sign in again with a code.
ZT_BOOTSTRAP_ADMIN_USERNAME=admin
ZT_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: bearer token (>= 32 chars) for Prometheus scrapes of http://backend:8000/metrics.
# ZT_METRICS_TOKEN=
