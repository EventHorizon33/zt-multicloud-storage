# Frontend image: multi-stage build of the Vite/React SPA, served by an
# unprivileged nginx that also proxies /api/ to the backend on the same origin
# (the refresh cookie is SameSite=Strict and Path=/api/auth, so UI and API must
# share one origin).
#
# Build context: the repository root.
#   docker build -f deploy/Dockerfile.frontend -t zt-frontend .
#
# STATUS: written but NOT built or run by the authors (see deploy/README.md).

FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# tsc -b (type check) + vite build -> dist/
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
# The unprivileged image runs as uid 101 and listens on 8080.
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
